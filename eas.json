{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "NODE_ENV": "development" },
      "node": "18.20.3"
    },
    "preview": {
      "distribution": "internal",
      "env": { "NODE_ENV": "preview" },
      "node": "18.20.3"
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "apk" },
      "env": { "NODE_ENV": "production" },
      "node": "18.20.3"
    }
  },
  "submit": { "production": {} }
}
